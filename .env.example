# ── adda environment ─────────────────────────────────────────────────
# Most people should NOT edit this file by hand — run ./scripts/install.sh
# and it generates everything below (secrets included) automatically.
#
# Two ways to run:
#   Production : ./scripts/install.sh        → ./install.sh on a server
#                docker compose --profile prod up -d --build
#   Local dev  : docker compose -f compose.yaml -f compose.dev.yaml up
#                (or `make stack-dev`) — dev mode ignores the https
#                settings and uses localhost ports instead.
#
# This file documents every variable install.sh may write.

# ── Your domain (production) ─────────────────────────────────────────
# DNS A record must point at this server. Ports 80 and 443 must be free.
ADDA_DOMAIN=adda.example.com

# ── Database (Postgres) ──────────────────────────────────────────────
# Password is generated by install.sh. Never reuse the dev default.
POSTGRES_USER=adda
POSTGRES_PASSWORD=          # install.sh: openssl rand -hex 16
POSTGRES_DB=adda
# Dev-overlay only: exposes Postgres on localhost.
POSTGRES_PORT=5432

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=                 # install.sh: openssl rand -hex 48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── First admin account ──────────────────────────────────────────────
# Seeded idempotently on startup. install.sh generates the password and
# shows it once — change it after first sign-in.
SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=        # install.sh: generated, shown once
# Dev only: seeds two extra test users.
SEED_TEST_USERS=false

# ── Backend ──────────────────────────────────────────────────────────
IS_DEBUG=false

# ── mediamtx (streaming) ─────────────────────────────────────────────
# Production publishes only RTMP :1935; playback goes through https on
# your domain (/hls/*). The dev overlay publishes the raw ports.
RTMP_PORT=1935
HLS_PORT=8888               # dev overlay only
WEBRTC_PORT=8889            # dev overlay only
MTX_API_PORT=9997           # dev overlay only
# Only needed when the backend runs natively (make backend):
# MTX_AUTH_ADDRESS=http://host.docker.internal:7001/api/streams/auth

# ── URLs the browser uses (production, filled by install.sh) ────────
CORS_ORIGINS=https://adda.example.com
HLS_BASE_URL=https://adda.example.com/hls
NEXT_PUBLIC_API_BASE_URL=https://adda.example.com
NEXT_PUBLIC_HLS_BASE_URL=https://adda.example.com/hls
PASSWORD_RESET_URL=https://adda.example.com/reset-password

# ── SMTP (email — password reset + account email) ────────────────────
# Leave SMTP_HOST empty to disable email. Without email, admins can
# still reset user passwords from the desktop console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=adda <noreply@adda.example.com>
SMTP_STARTTLS=true

# ── Google OAuth 2.0 (optional — MVP1 ships email-only) ─────────────
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Dev-overlay ports ────────────────────────────────────────────────
BACKEND_PORT=7001
FRONTEND_PORT=5173
REDIS_PORT=6379
