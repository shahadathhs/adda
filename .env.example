# ── adda environment ──────────────────────────────────────────────
# Copy to `.env` and edit. Everything has a sensible default for local dev.

# ── Database (Postgres) ──
POSTGRES_USER=adda
POSTGRES_PASSWORD=adda
POSTGRES_DB=adda
POSTGRES_PORT=5432
# Used by the backend when running outside docker (host networking).
# In docker-compose the backend uses the service URL override instead.
DATABASE_URL=postgresql+asyncpg://adda:adda@localhost:5432/adda

# ── Redis ──
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── Auth ──
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Backend ──
BACKEND_PORT=7001
IS_DEBUG=true

# ── mediamtx ──
RTMP_PORT=1935
HLS_PORT=8888
WEBRTC_PORT=8889
MTX_API_PORT=9997
# Used by backend to talk to the mediamtx REST API
MTX_API_URL=http://localhost:9997
# Base URLs the browser uses for playback
HLS_BASE_URL=http://localhost:8888
WEBRTC_BASE_URL=http://localhost:8889

# ── Backend bootstrap (passed to the backend container) ───────────────
# Accounts seeded idempotently on startup. Override with strong values in prod.
SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=admin12345
SEED_TEST_USERS=true
SEED_TEST_PASSWORD=password123

# ── SMTP (email — for password reset, 2FA, OTP login) ───────────────
# Leave SMTP_HOST empty to disable email (dev). Set all for production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=adda <noreply@adda.example>
SMTP_STARTTLS=true

# ── Google OAuth 2.0 ────────────────────────────────────────────────
# Set to your Google OAuth client ID to enable "Sign in with Google".
# Get one at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
# Same ID, exposed to the browser (for the Google sign-in button)
VITE_GOOGLE_CLIENT_ID=

# ── Password reset ───────────────────────────────────────────────────
PASSWORD_RESET_URL=http://localhost:5173/reset-password
RESET_TOKEN_EXPIRE_MINUTES=30
