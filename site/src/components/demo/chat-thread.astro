---
/*
 * Chat thread demo — the chat anatomy: 13px lines, colored usernames,
 * mention chip, mod badge, mono timestamps.
 */
const messages = [
	{
		name: 'rifat',
		color: '#5aa9e6',
		time: '21:04',
		text: 'stream starts in ten, grab your seats',
	},
	{
		name: 'nabila',
		color: '#d67ab1',
		time: '21:05',
		text: 'finally. the playlist is unreal tonight',
		mod: true,
	},
	{
		name: 'tanvir',
		color: '#4cc38a',
		time: '21:07',
		text: '@rifat saving me a spot up front',
		mention: true,
	},
	{ name: 'rifat', color: '#5aa9e6', time: '21:07', text: 'front row is yours' },
];
---

<div class="thread" role="img" aria-label="Example chat thread">
	{messages.map((m) => (
		<p class="row">
			<time>{m.time}</time>
			<span class="name" style={`color:${m.color}`}>
				{m.mod && <span class="mod">mod</span>}
				{m.name}
			</span>
			<span class="text">
				{m.mention && <span class="mention">{m.text.split(' ')[0]}</span>}
				{m.mention ? m.text.slice(m.text.indexOf(' ') + 1) : m.text}
			</span>
		</p>
	))}
</div>

<style>
	.thread {
		display: grid;
		gap: 0.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 8px;
		background: #14161b;
	}

	.row {
		margin: 0;
		font-size: 0.8125rem;
		line-height: 1.4;
		display: flex;
		gap: 0.375rem;
		flex-wrap: wrap;
		align-items: baseline;
	}

	time {
		font-size: 0.6875rem;
		color: var(--sl-color-gray-5);
		font-variant-numeric: tabular-nums;
	}

	.name {
		font-weight: 600;
		white-space: nowrap;
	}

	.mod {
		font-size: 0.625rem;
		font-weight: 700;
		text-transform: uppercase;
		color: var(--sl-color-gray-1);
		background: var(--sl-color-gray-4);
		border-radius: 3px;
		padding: 0 0.25rem;
		margin-right: 0.25rem;
	}

	.text {
		color: var(--sl-color-gray-2);
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.mention {
		background: var(--adda-accent-subtle);
		color: var(--adda-accent);
		border-radius: 3px;
		padding: 0 0.25rem;
		font-weight: 500;
	}
</style>
