---
/*
 * Landing hero — oversized display type, one marigold CTA, ghost
 * secondaries, live pulse motif. The product mock (hero-mock.astro)
 * is placed directly below by the page.
 */
---

<header class="hero">
	<p class="eyebrow">self-hosted · multi-tenant · yours</p>
	<h1 class="title">Your community's live home,<br />on your own server.</h1>
	<p class="tagline">
		Channels, chat, live streams, recordings, and direct messages — one
		command on hardware you control.
	</p>
	<div class="actions">
		<a class="sl-link-button primary" href="/quickstart/">Get started</a>
		<a class="sl-link-button secondary" href="/guides/self-hosting/">Self-hosting guide</a>
		<a class="sl-link-button minimal" href="/guides/streaming/">Go live with OBS</a>
	</div>
	<p class="live-line">
		<span class="pulse" aria-hidden="true"></span>
		<span class="live-label">LIVE</span>
		<strong>3</strong>
		channels streaming on one box right now
	</p>
</header>

<style>
	.hero {
		max-width: 56rem;
		margin-inline: auto;
		padding: 5.5rem 1.25rem 0;
		text-align: center;
	}

	.eyebrow {
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #676e7c;
		margin: 0 0 1.5rem;
	}

	.title {
		font-family: var(--adda-font-display);
		font-size: clamp(2.75rem, 7vw, 4.75rem);
		line-height: 1.02;
		letter-spacing: -0.03em;
		font-weight: 700;
		margin: 0;
		text-wrap: balance;
	}

	.tagline {
		font-size: 1.1875rem;
		line-height: 1.6;
		color: #9aa1af;
		max-width: 42ch;
		margin: 1.75rem auto 0;
	}

	.actions {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.25rem;
	}

	.live-line {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 2.5rem 0 0;
		padding: 0.375rem 0.75rem 0.375rem 0.625rem;
		border: 1px solid #20242c;
		border-radius: 6px;
		background: #12151a;
		font-size: 0.8125rem;
		color: #9aa1af;
	}

	.live-line strong {
		color: #edeef2;
		font-variant-numeric: tabular-nums;
	}

	.live-label {
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		color: #fff;
		background: var(--adda-live);
		border-radius: 3px;
		padding: 0.0625rem 0.375rem;
	}

	.pulse {
		position: relative;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--adda-live);
	}

	.pulse::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 2px solid var(--adda-live);
		animation: pulse-ring 2s var(--adda-ease-micro) infinite;
	}

	@keyframes pulse-ring {
		from {
			transform: scale(1);
			opacity: 0.6;
		}
		to {
			transform: scale(1.8);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pulse::after {
			animation: none;
			display: none;
		}
	}
</style>
