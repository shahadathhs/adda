# ── adda backend env ──────────────────────────────────────────────────
# Copy to .env and edit. These are local-dev defaults; docker-compose
# overrides DATABASE_URL / REDIS_URL / MTX_API_URL for its container network.

APP_NAME=adda
DEBUG=true
API_PREFIX=/api

# Database / cache
DATABASE_URL=postgresql+asyncpg://adda:adda@localhost:5432/adda
REDIS_URL=redis://localhost:6379/0

# Auth — generate a secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth 2.0 (ID-token flow). Leave empty to disable.
# Create an OAuth client id: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Password reset — frontend page the email links to (?token=… appended),
# and how long the signed reset token stays valid.
PASSWORD_RESET_URL=http://localhost:5173/reset-password
RESET_TOKEN_EXPIRE_MINUTES=30

# Email (SMTP). Leave SMTP_HOST empty to skip sending (e.g. in dev).
# Gmail: use an App Password (https://myaccount.google.com/apppasswords), port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=adda <noreply@adda.example>
SMTP_STARTTLS=true

# mediamtx (streaming server) — must match mediamtx/mediamtx.yml authInternalUsers
MTX_API_URL=http://localhost:9997
MTX_API_USER=admin
MTX_API_PASS=admin

# Base URLs returned to clients (browser / OBS). Use host-reachable addresses.
HLS_BASE_URL=http://localhost:8888
WEBRTC_BASE_URL=http://localhost:8889
RTMP_BASE_URL=rtmp://localhost:1935

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# ── Bootstrap accounts (seeded idempotently on startup) ───────────────
# Override all with strong values in production.
SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=admin12345
SEED_TEST_USERS=true
SEED_TEST_PASSWORD=password123
