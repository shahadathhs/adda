# Next.js viewer app defaults (baked at build; runtime-configurable clients
# can still override via localStorage server config).
NEXT_PUBLIC_API_BASE_URL=http://localhost:7001
NEXT_PUBLIC_HLS_BASE_URL=http://localhost:8888
# Server-side (RSC/SSR) fetch origin — inside docker-compose this is
# http://backend:7001; locally http://localhost:7001.
API_SSR_URL=http://localhost:7001
